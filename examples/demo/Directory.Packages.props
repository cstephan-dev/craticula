<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Versions mirror csharp/Directory.Packages.props. Dapper and MongoDB.Driver also reach the demo through the
       Craticula adapters; the demo references them directly because it owns the real connections. -->
  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="MongoDB.Driver" Version="3.11.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="OpenSearch.Client" Version="2.1.0" />
    <!-- A security pin, not a new library (same as csharp/Directory.Packages.props, #1660): SqlClient 7.1.0 depends on
         System.Security.Cryptography.Pkcs 9.0.18, which has a high and a moderate advisory (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7), patched in 10.0.13. Drop this line and the reference in Api/Demo.Api.csproj once a SqlClient
         release depends on a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>

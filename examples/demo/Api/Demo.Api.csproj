<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Demo.Api</RootNamespace>
    <AssemblyName>Demo.Api</AssemblyName>
  </PropertyGroup>

  <!-- The library is not published yet, so the demo references its projects. After the first release these eight
       lines become PackageReference items (Craticula.Core, .AgGrid, .Sql, .Dapper, .EntityFrameworkCore, .Mongo,
       .MongoDB.Driver, .Export.Csv) and the demo no longer needs a checkout of csharp/. -->
  <ItemGroup>
    <ProjectReference Include="../../../csharp/src/Craticula.Core/Craticula.Core.csproj" />
    <ProjectReference Include="../../../csharp/src/Craticula.AgGrid/Craticula.AgGrid.csproj" />
    <ProjectReference Include="../../../csharp/src/Craticula.Sql/Craticula.Sql.csproj" />
    <ProjectReference Include="../../../csharp/src/Craticula.Dapper/Craticula.Dapper.csproj" />
    <ProjectReference Include="../../../csharp/src/Craticula.EntityFrameworkCore/Craticula.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../../csharp/src/Craticula.Mongo/Craticula.Mongo.csproj" />
    <ProjectReference Include="../../../csharp/src/Craticula.MongoDB.Driver/Craticula.MongoDB.Driver.csproj" />
    <ProjectReference Include="../../../csharp/src/Craticula.Export.Csv/Craticula.Export.Csv.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySqlConnector" />
    <!-- Not used by name: lifts SqlClient's transitive System.Security.Cryptography.Pkcs to a patched version (Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../orders.schema.json" Link="orders.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

{
  "pipeline": [
    {
      "$match": {
        "$or": [
          {
            "status": {
              "$nin": [
                "inactive",
                "archived"
              ]
            }
          },
          {
            "status": null
          }
        ]
      }
    },
    {
      "$addFields": {
        "__idNullBucket": {
          "$cond": [
            {
              "$eq": [
                "$id",
                null
              ]
            },
            1,
            0
          ]
        }
      }
    },
    {
      "$sort": {
        "__idNullBucket": 1,
        "id": 1
      }
    },
    {
      "$skip": 0
    },
    {
      "$limit": 100
    }
  ],
  "collation": {
    "locale": "en",
    "strength": 2
  }
}

[
  {
    "$match": {
      "$or": [
        {
          "productName": {
            "$not": {
              "$regex": "gizmo",
              "$options": "i"
            }
          }
        },
        {
          "productName": null
        }
      ]
    }
  },
  {
    "$addFields": {
      "__idNullBucket": {
        "$cond": [
          {
            "$eq": [
              "$id",
              null
            ]
          },
          1,
          0
        ]
      }
    }
  },
  {
    "$sort": {
      "__idNullBucket": 1,
      "id": 1
    }
  },
  {
    "$unset": "__idNullBucket"
  },
  {
    "$skip": 0
  },
  {
    "$limit": 100
  }
]

{
  "pipeline": [
    {
      "$match": {
        "$and": [
          {
            "$and": [
              {
                "status": {
                  "$eq": "active"
                }
              },
              {
                "quantity": {
                  "$gt": 10
                }
              },
              {
                "region": {
                  "$eq": "west"
                }
              }
            ]
          },
          {
            "$nor": [
              {
                "customerName": {
                  "$regex": "test",
                  "$options": "i"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "$addFields": {
        "__idNullBucket": {
          "$cond": [
            {
              "$eq": [
                "$id",
                null
              ]
            },
            1,
            0
          ]
        }
      }
    },
    {
      "$sort": {
        "__idNullBucket": 1,
        "id": 1
      }
    },
    {
      "$unset": "__idNullBucket"
    },
    {
      "$skip": 0
    },
    {
      "$limit": 100
    }
  ],
  "collation": {
    "locale": "en",
    "strength": 2
  }
}

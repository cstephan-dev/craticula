{
  "pipeline": [
    {
      "$match": {
        "$and": [
          {
            "$or": [
              {
                "lastName": {
                  "$regex": "^Van",
                  "$options": "i"
                }
              },
              {
                "lastName": {
                  "$regex": "sen",
                  "$options": "i"
                }
              }
            ]
          },
          {
            "department": {
              "$in": [
                "Engineering",
                "Support"
              ]
            }
          }
        ]
      }
    },
    {
      "$addFields": {
        "__idNullBucket": {
          "$cond": [
            {
              "$eq": [
                "$id",
                null
              ]
            },
            1,
            0
          ]
        }
      }
    },
    {
      "$sort": {
        "__idNullBucket": 1,
        "id": 1
      }
    },
    {
      "$unset": "__idNullBucket"
    },
    {
      "$skip": 0
    },
    {
      "$limit": 100
    }
  ],
  "collation": {
    "locale": "en",
    "strength": 2
  }
}

{
  "pipeline": [
    {
      "$match": {
        "$and": [
          { "lastName": { "$eq": "smith" } },
          { "$expr": { "$eq": ["$employeeCode", { "$literal": "AB-100" }] } }
        ]
      }
    },
    {
      "$addFields": {
        "__idNullBucket": { "$cond": [{ "$eq": ["$id", null] }, 1, 0] }
      }
    },
    { "$sort": { "__idNullBucket": 1, "id": 1 } },
    { "$unset": "__idNullBucket" },
    { "$skip": 0 },
    { "$limit": 100 }
  ],
  "collation": { "locale": "en", "strength": 2 }
}

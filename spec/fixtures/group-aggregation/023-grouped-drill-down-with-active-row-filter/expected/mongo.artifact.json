[
  {
    "$match": {
      "$and": [
        {
          "$and": [
            {
              "region": {
                "$eq": "EMEA"
              }
            },
            {
              "segment": {
                "$eq": "Enterprise"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "fiscalYear": {
                "$gte": 2023
              }
            },
            {
              "quantity": {
                "$lt": 500
              }
            }
          ]
        }
      ]
    }
  },
  {
    "$group": {
      "_id": "$product",
      "amount_sum": {
        "$sum": "$amount"
      }
    }
  },
  {
    "$addFields": {
      "__groupNullBucket": {
        "$cond": [
          {
            "$eq": [
              "$_id",
              null
            ]
          },
          1,
          0
        ]
      }
    }
  },
  {
    "$sort": {
      "__groupNullBucket": 1,
      "_id": 1
    }
  },
  {
    "$unset": "__groupNullBucket"
  },
  {
    "$skip": 0
  },
  {
    "$limit": 100
  }
]

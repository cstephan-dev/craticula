                "field": "region"
              }
            }
          }
        }
      ]
    }
  },
  "size": 0,
  "aggs": {
    "segment": {
      "composite": {
        "size": 100,
        "sources": [
          {
            "segment": {
              "terms": {
                "field": "segment.keyword",
                "missing_bucket": true
              }
            }
          }
        ]
      },
      "aggs": {
        "amount_sum": {
          "sum": {
            "field": "amount"
          }
        }
      }
    }
  }
}

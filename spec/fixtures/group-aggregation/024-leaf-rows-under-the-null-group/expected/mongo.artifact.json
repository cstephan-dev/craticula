      "id": 1
    }
  },
  {
    "$unset": "__idNullBucket"
  },
  {
    "$skip": 0
  },
  {
    "$limit": 100
  },
  {
    "$project": {
      "id": 1,
      "region": 1,
      "segment": 1,
      "product": 1,
      "fiscalYear": 1,
      "amount": 1,
      "quantity": 1,
      "_id": 0
    }
  }

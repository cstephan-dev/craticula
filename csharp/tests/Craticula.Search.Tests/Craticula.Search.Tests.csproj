<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Craticula.Search/Craticula.Search.csproj" />
    <!-- The conformance tests drive the REAL end-to-end path a host uses (AgGridRequestParser ->
         GridFilterPipeline -> SearchQueryBuilder), so the test project references the adapter even
         though Craticula.Search itself deliberately does not. -->
    <ProjectReference Include="../../src/Craticula.AgGrid/Craticula.AgGrid.csproj" />
    <!-- ...and the SQL and Mongo compilers, for the cross-compiler grouping test alone: the claim
         under test is that all three backends make the SAME GRP-* decisions, which no per-backend
         artifact suite can check because each only ever compares a compiler against its own
         hand-written arm. -->
    <ProjectReference Include="../../src/Craticula.Sql/Craticula.Sql.csproj" />
    <ProjectReference Include="../../src/Craticula.Mongo/Craticula.Mongo.csproj" />
  </ItemGroup>

</Project>

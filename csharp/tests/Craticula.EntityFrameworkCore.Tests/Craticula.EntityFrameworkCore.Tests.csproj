<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!-- The provider, which the adapter under test deliberately does NOT reference: it is the host's
         choice, and here the host is this test project. SQLite in-memory is what makes AR-4's
         execution-equality claim checkable on every commit with no infrastructure — see
         ExecutionEqualityHarness. It is also the reason EfCoreProviderSemantics.Sqlite is the one
         preset that ships: these tests are what measure its five values. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Craticula.EntityFrameworkCore/Craticula.EntityFrameworkCore.csproj" />

    <!-- AR-4's whole claim is about TWO paths agreeing, so the harness compiles the SQL side on the fly
         with the real compiler and executes that text as well. The adapter itself must never reference
         Craticula.Sql (AR-3); a test comparing them obviously must. -->
    <ProjectReference Include="../../src/Craticula.Sql/Craticula.Sql.csproj" />

    <!-- The fixtures are AG Grid wire requests, so the harness drives the real end-to-end host path
         (AgGridRequestParser -> GridFilterPipeline -> both compilers), exactly as
         Craticula.Sql.Tests does. -->
    <ProjectReference Include="../../src/Craticula.AgGrid/Craticula.AgGrid.csproj" />

    <!-- EXP-3/EXP-4: the export stream's real consumer, so that "a row stream usable by CsvWriter" is
         demonstrated rather than asserted. -->
    <ProjectReference Include="../../src/Craticula.Export.Csv/Craticula.Export.Csv.csproj" />
  </ItemGroup>

</Project>

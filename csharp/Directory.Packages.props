<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- #1646: Craticula.Dapper's one runtime dependency — current stable as of implementation time
         (verified on nuget.org; 2.1.79 is the newest non-prerelease release). -->
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <!-- #1646: Craticula.Dapper.Tests' own test-only provider (mirrors why
         Craticula.EntityFrameworkCore.Tests references Microsoft.EntityFrameworkCore.Sqlite — the
         adapter under test never references a provider itself). Pinned to the same 10.0.11 family as
         the EF Core packages above rather than the bare package's own latest, since this repo already
         targets that release line for net10.0. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- #1647: Craticula.MongoDB.Driver's one runtime dependency — current stable as of implementation
         time (verified on nuget.org; 3.11.0 is the newest non-prerelease release). Unlike Dapper's ADO.NET
         abstraction, MongoDB has exactly one .NET driver, so Craticula.MongoDB.Driver.Tests references
         the SAME package directly (as the host owning the real connection) rather than a separate
         test-only provider. -->
    <PackageVersion Include="MongoDB.Driver" Version="3.11.0" />
    <!-- #1648: Craticula.OpenSearch.Client's one runtime dependency — current stable as of implementation
         time (verified on nuget.org; 2.1.0 is the newest non-prerelease release). Craticula.OpenSearch.Client.Tests
         references the SAME package directly (as the host owning the real connection), mirroring
         Craticula.MongoDB.Driver.Tests' own precedent rather than Craticula.Dapper.Tests' separate-provider one:
         OpenSearch.Client is both the wire protocol AND the low-level client this package executes through. -->
    <PackageVersion Include="OpenSearch.Client" Version="2.1.0" />
    <!-- #1655 (#2205): the execution-equality tier's test-only packages, approved in docs/compliance/tech-stack.approved.md
         on 2026-10-10 and used by Craticula.Integration.Tests only (AR-3). Each is the newest stable release at least two
         weeks old on 2026-10-10 (nuget.org): Testcontainers 4.15.0 (2026-09-06), Npgsql 10.0.3, MySqlConnector 2.6.2,
         Microsoft.Data.SqlClient 7.1.0 (2026-09-18). Elasticsearch needs no client package (raw HttpClient, #2207). -->
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.OpenSearch" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Elasticsearch" Version="4.15.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>

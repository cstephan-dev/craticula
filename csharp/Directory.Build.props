<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- #1660 (TRD P-3, dependency audit): NuGetAudit on every project, src, tests and tools alike, because a
       vulnerable test-only client still runs on the build agent. Mode "all" audits the transitive graph, not only
       the packages named in Directory.Packages.props. Every severity is reported (level "low"); a high (NU1903) or
       critical (NU1904) advisory fails the restore, a low (NU1901) or moderate (NU1902) one warns and so still
       breaks the 0-warning bar until it is fixed or suppressed with a NuGetAuditSuppress item that names the
       advisory URL and the reason. Needs nuget.org's vulnerability data: an offline restore only warns (NU1900). -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>

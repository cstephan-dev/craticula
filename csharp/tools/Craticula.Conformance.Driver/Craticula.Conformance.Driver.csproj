<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Craticula.Conformance.Driver</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- AR-3: the request parser and the three compilers, nothing else. The driver prints compiled
         artifacts (spec/conformance-runner.md §3) and never executes one, so it never references an
         execution adapter (Dapper, EF Core, MongoDB.Driver, OpenSearch.Client) nor a package: the
         pinned clock it needs is eight lines of its own, not a dependency. -->
    <ProjectReference Include="../../src/Craticula.Core/Craticula.Core.csproj" />
    <ProjectReference Include="../../src/Craticula.AgGrid/Craticula.AgGrid.csproj" />
    <ProjectReference Include="../../src/Craticula.Sql/Craticula.Sql.csproj" />
    <ProjectReference Include="../../src/Craticula.Mongo/Craticula.Mongo.csproj" />
    <ProjectReference Include="../../src/Craticula.Search/Craticula.Search.csproj" />
  </ItemGroup>

</Project>

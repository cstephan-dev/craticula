<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Craticula MongoDB compiler: turns the canonical IR into an injection-safe MongoDB aggregation pipeline (Extended JSON).</Description>
    <RootNamespace>Craticula.Mongo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- AR-3: no MongoDB driver package, deliberately. The compiled artifact is Extended JSON that
         this project emits by hand through System.Text.Json.Nodes, so the compiler carries no
         transitive dependency on any one driver's document model or its version. -->
    <ProjectReference Include="../Craticula.Core/Craticula.Core.csproj" />
  </ItemGroup>

</Project>

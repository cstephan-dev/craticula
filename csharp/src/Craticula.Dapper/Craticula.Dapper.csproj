<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Craticula execution adapter for Dapper: compiles the IR to parameterized SQL and runs it, with paging, counts and streamed export.</Description>
    <RootNamespace>Craticula.Dapper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- DapperParameterBinder's Postgres array-binding fix (the reflection-based typed-array rebuild in
         NamedParameters.ToTypedArray) is unit-tested offline here, because every other Craticula.Dapper.Tests
         case runs against SQLite, which never reaches that dialect-specific branch (the live Postgres run
         is DapperPostgresExecutionTests in the execution-equality tier, #1655). Granting the test project
         access to this one internal type is what lets the binding LOGIC be unit-tested directly. -->
    <InternalsVisibleTo Include="Craticula.Dapper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- This package's one runtime dependency. Version centrally managed in
         csharp/Directory.Packages.props — this file names the package and, via VersionOverride, the published range
         (#1658: the nuspec range; restore still resolves its lowest version, the tested one). -->
    <PackageReference Include="Dapper" VersionOverride="[2.1.79,3.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Craticula.Core AND Craticula.Sql — the one point where this adapter does NOT generalize EF
         Core's precedent. EfCoreEntityFrameworkCore is a documented AR-4 EXCEPTION (it compiles IR
         straight to IQueryable<T> expression trees and never produces SQL text, so it references Core
         only); every other execution adapter compiles its own IR through its own compiler as a normal,
         intended production edge (docs/architecture/c4-containers.md: `Rel(sqlc, dapper, "{sql,
         params[]}")`). This package's whole job is executing the {sql, params[]} artifact
         Craticula.Sql.SqlQueryBuilder.Build already produces — it never re-derives a SEM-*/SQL-*
         rendering rule of its own. -->
    <ProjectReference Include="../Craticula.Core/Craticula.Core.csproj" />
    <ProjectReference Include="../Craticula.Sql/Craticula.Sql.csproj" />
  </ItemGroup>

  <!-- Not Craticula.AgGrid: this adapter's own ToGridPageResult() extension (#1649) names
       Craticula.AgGrid.LoadSuccessParamsMapper.Map only in a plain-prose doc comment (a <c> tag, not a <see cref>): src/Directory.Build.props turns on GenerateDocumentationFile (#1658), so every
         <see cref> is compiler-checked, and a cref to Craticula.AgGrid would need the very reference this package
         must not have. This package still only ever
       executes the {sql, params[]} artifact Craticula.Sql.SqlQueryBuilder.Build produces. -->

</Project>
